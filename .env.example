# Copia este archivo a `.env` y ajusta las rutas.
# Solo hace falta para limpiar datos REALES de BACI (`DataCleaner.clean_trade_data`).
# Para probar la librería con los datos de ejemplo no necesitas nada de esto.

# Directorio con los CSV crudos de BACI-CEPII. Debe terminar en /
RAW_DATA_DIR=data/raw_data/BACI_HS92_V202401b/

# Directorio donde se escriben los datos limpios. Debe terminar en /
CLEANED_DATA_DIR=data/processed_data/BACI_HS92_V202401b/cleaned_trade_data/

# Países y regiones del Banco Mundial (CSV con columnas `id` y `region.value`)
WBD_COUNTRIES=data/raw_data/world_bank_data/countries.csv

# Deflactor del PIB del Banco Mundial, serie enlazada
WBD_GDP_DEFLATOR=data/raw_data/world_bank_data/NY.GDP.DEFL.ZS.AD_1995-2023.csv

# Solo para el subsistema graph_db (opcional, inconcluso)
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
